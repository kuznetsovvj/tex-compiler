<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] — TexCompiler</title>
    @* Тема выставляется до подключения стилей и до первой отрисовки: иначе
       страница на мгновение показывается светлой и только потом темнеет.
       Поэтому скрипт инлайновый и стоит выше link на CSS — вынесенный в файл,
       он давал бы то самое мигание, ради устранения которого нужен. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('tex-compiler-theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
            } catch (e) {
                // localStorage закрыт настройками приватности — остаётся светлая тема.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TexCompiler.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">TeX</span>
                <span>TexCompiler</span>
            </a>
            <button type="button" id="themeToggle" class="theme-toggle" aria-label="Переключить тему">
                <svg class="theme-toggle__sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.5" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.5 1.5m11.2 11.2l1.5 1.5M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" />
                </svg>
                <svg class="theme-toggle__moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z" />
                </svg>
            </button>
        </div>
    </header>

    <main class="app-main" role="main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-footer__inner">
            <span>&copy; 2025 <a href="https://t.me/v_y_kuznetsov">Vladimir Kuznetsov</a></span>
            <span>v.0.8b</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
