@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

@* Страница показывается пользователю, поэтому текст про переменную
   ASPNETCORE_ENVIRONMENT и режим Development из шаблона проекта убран: он адресован
   разработчику, а посетителю сервиса подсказывает только то, что здесь можно
   включить вывод подробностей об исключении. *@
<section class="hero error-page">
    <p class="hero__eyebrow">Ошибка</p>
    <h1 class="hero__title">Что-то пошло не так</h1>
    <p class="error-page__text">
        Запрос не удалось обработать. Если ошибка повторяется, пришлите код запроса
        вместе с описанием того, что вы делали.
    </p>

    @if (Model.ShowRequestId)
    {
        <code class="error-page__id">@Model.RequestId</code>
    }

    <div class="error-page__actions">
        <a class="btn btn--primary" asp-area="" asp-controller="Home" asp-action="Index">
            Вернуться к компиляции
        </a>
    </div>
</section>
