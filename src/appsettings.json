{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CompilationSettings": {
    "ProcessTimeoutSeconds": 600
  },
  "CompilationContainer": {
    "EnableIsolation": true,
    "Image": "texcompiler-base:latest",
    "WorkspaceRoot": "/tasks",
    "WorkspaceHostRoot": "",
    "MemoryMegabytes": 1024,
    "CpuCount": 1,
    "PidsLimit": 256,
    "TmpSizeMegabytes": 64
  },
  "UploadSettings": {
    "MaxFileSizeMegabytes": 20
  }
}
