{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CompilationSettings": {
    "ProcessTimeoutSeconds": 600
  },
  "CompilationContainer": {
    "EnableIsolation": true,
    "Image": "texcompiler-base:latest",
    "WorkspaceRoot": "/tasks",
    "WorkspaceHostRoot": "",
    "MemoryMegabytes": 1024,
    "CpuCount": 1,
    "PidsLimit": 256,
    "TmpSizeMegabytes": 64
  },
  "UploadSettings": {
    "MaxFileSizeMegabytes": 20
  },
  "ExtractionLimits": {
    "MaxTotalBytes": 524288000,
    "MaxFileBytes": 104857600,
    "MaxEntries": 10000,
    "MaxCompressionRatio": 100,
    "MaxNestingDepth": 32
  },
  "CompilationQueue": {
    "Capacity": 50,
    "EnqueueTimeoutSeconds": 2
  },
  "RateLimiting": {
    "UploadPermitLimit": 20,
    "UploadWindowMinutes": 5
  }
}
