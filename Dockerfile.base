# Базовый образ зафиксирован по digest манифест-листа, а не по плавающему тегу:
# повторная сборка в любой момент дает ту же основу, обновление - осознанное
# изменение digest здесь (проверяется workflow базового образа раз в неделю)
FROM ubuntu:22.04@sha256:74b12b11ffa550fba1929ad4d8d16533c34f6612728469671afba1b03b66881c

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Moscow

RUN ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

RUN apt-get update && \
    apt-get install -y \
    texlive-full \
    asymptote \
    ghostscript \
    python3 \
    make \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean
